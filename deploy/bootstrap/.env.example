# Operator-only bootstrap in a separate clean checkout, AFTER resource/cost approval and real CI/deployment.
# Load a private file OUTSIDE the checkout with Node --env-file. Do not run setup:local there.
# Do not place this configuration or credentials in Actions, the frontend, Git, or chat.
NODE_ENV=production
BOOTSTRAP_REVISION=
FIREBASE_PROJECT_ID=
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Do not configure FIREBASE_STORAGE_BUCKET or emulator hosts in this Spark + Cloudinary environment.
# Use the Users owner's credential for --stage=users, Content owner's for --stage=content.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SEED_READER_EMAIL=
SEED_AUTHOR_EMAIL=
SEED_ADMIN_EMAIL=
# Generate a private 24-128-character password, never the development password.
SEED_PASSWORD=
# Copy approved actual IDs/origins, not RENDER_API_KEY, from the release settings.
RENDER_BLUEPRINT_ID=
RENDER_USERS_SERVICE_ID=
RENDER_USERS_ORIGIN=
RENDER_CONTENT_SERVICE_ID=
RENDER_CONTENT_ORIGIN=
RENDER_INTERACTIONS_SERVICE_ID=
RENDER_INTERACTIONS_ORIGIN=
RENDER_GATEWAY_SERVICE_ID=
RENDER_GATEWAY_ORIGIN=
