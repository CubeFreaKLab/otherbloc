{
  "name": "otherbloc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/run-service.mjs frontend",
    "dev:gateway": "node scripts/run-service.mjs api-gateway",
    "dev:users": "node scripts/run-service.mjs users-service",
    "dev:content": "node scripts/run-service.mjs content-service",
    "dev:interactions": "node scripts/run-service.mjs interactions-service",
    "build": "npm run build --workspace frontend",
    "test": "npm run test:foundation && npm run test --workspaces --if-present",
    "test:foundation": "node --test tests/foundation.test.js tests/ci.test.js tests/release-render.test.mjs tests/release-hosting.test.mjs",
    "test:ui": "playwright test",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ci": "node scripts/ci.mjs",
    "test:load": "node scripts/load.mjs",
    "lint": "eslint . --max-warnings 0",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "seed:content": "node scripts/seed-content.mjs",
    "emulators": "node scripts/emulators.mjs",
    "emulators:export": "node scripts/emulators.mjs export",
    "test:integration": "node scripts/emulators.mjs test",
    "test:integration:running": "node scripts/emulators.mjs test-running"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "wawoff2": "^2.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
}
